{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
        "<rootDir>/test/setup.ts"
    ],
    "collectCoverageFrom": [
        "src/**/*.ts",
        "!src/**/*.module.ts",
        "!src/main.ts",
        "!src/**/*.dto.ts"
    ],
    "coverageDirectory": "./coverage/unit"
}