{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "testRegex": "src/.*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
        "/node_modules/",
        "/dist/"
    ],
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1",
        "^graphql-upload/(.*)\\.mjs$": "<rootDir>/test/mocks/graphql-upload.mock.ts"
    },
    "setupFiles": [
        "<rootDir>/test/setup.ts"
    ],
    "collectCoverageFrom": [
        "src/**/*.ts",
        "!src/**/*.module.ts",
        "!src/main.ts",
        "!src/**/*.dto.ts"
    ],
    "coverageDirectory": "./coverage/unit"
}